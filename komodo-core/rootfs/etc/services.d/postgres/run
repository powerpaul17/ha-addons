#!/usr/bin/with-contenv bashio

bashio::log.info "Starting Postgres for Komodo Core..."

export PGDATA=/data/postgres

export POSTGRES_USER=postgres
export POSTGRES_PASSWORD=postgres

if [ ! -d $PGDATA ]; then
  mkdir -p $PGDATA
  chown postgres $PGDATA
  su postgres -c "/usr/lib/postgresql/15/bin/initdb --username=$POSTGRES_USER --pwfile=<(printf \"%s\n\" $POSTGRES_PASSWORD)"

  printf %b "shared_preload_libraries = 'pg_cron,pg_documentdb_core,pg_documentdb'\ncron.database_name = 'postgres'\ndocumentdb.enableCompact = true\ndocumentdb.enableLetAndCollationForQueryMatch = true\ndocumentdb.enableNowSystemVariable = true\ndocumentdb.enableSortbyIdPushDownToPrimaryKey = true\ndocumentdb.enableSchemaValidation = true\ndocumentdb.enableBypassDocumentValidation = true\ndocumentdb.enableUserCrud = true\ndocumentdb.maxUserLimit = 100\n" >> $PGDATA/postgresql.conf
fi

su postgres -c "/usr/lib/postgresql/15/bin/postgres"
